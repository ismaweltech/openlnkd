LINKEDIN_EMAIL=your@email.com
LINKEDIN_PASSWORD=yourpassword
DATABASE_PATH=./data/openlnkd.db
PORT=3000
HEADLESS=true
SLOW_MO=50

# PostgreSQL (optional — leave blank to use SQLite)
# DATABASE_URL=postgres://user:password@localhost:5432/openlnkd

# Webhooks (optional)
# WEBHOOK_URL — configure via API: POST /webhooks { "url": "https://...", "interval_sec": 300 }

# Update check (optional) — on startup, compares your version against the latest
# GitHub release and logs a notice if a newer one exists. Only reads GitHub's
# public API; sends NO user or usage data. Set to false to disable.
# UPDATE_CHECK=false
